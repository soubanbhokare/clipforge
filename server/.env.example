# CLIPFORGE server — example environment variables.
# Copy to .env for local development. Names only — never put real
# credentials in this file, in frontend code, or in git.

# Port the API listens on (frontend dev proxy targets this).
PORT=3001

# development | production | test
# In production the session cookie is marked Secure (HTTPS only).
NODE_ENV=development

# Public base URL of the frontend, used to build links inside emails.
APP_BASE_URL=http://localhost:5173

# SQLite database file (development default).
# PRODUCTION: PostgreSQL is the production database path — the schema
# in src/db.ts is portable SQL mirroring these exact tables; provision
# PostgreSQL and re-point the data layer before going live.
DATABASE_FILE=./data/clipforge.db

# Session lifetimes.
SESSION_TTL_HOURS=12
REMEMBER_ME_TTL_DAYS=30

# If true, unverified users cannot sign in until email verification
# succeeds. Default false: users can sign in, and verification state is
# shown honestly in the UI.
REQUIRE_EMAIL_VERIFICATION=false

# Optional rate-limit overrides (defaults in src/config.ts).
# LOGIN_RATE_MAX=10
# REGISTER_RATE_MAX=10
# RESET_RATE_MAX=5
# RESEND_RATE_MAX=3

# --- Email (optional) ---------------------------------------------------
# Leave SMTP_HOST empty to use the development outbox adapter, which
# writes outgoing emails as JSON files under server/data/outbox/
# instead of delivering them. Nothing is "sent" in that mode.
# Set all five to deliver for real through ANY SMTP account — free
# options: Brevo (free, 300 emails/day; host smtp-relay.brevo.com,
# port 587) or Resend (free tier; host smtp.resend.com, port 587).
# The SMTP transport is implemented (nodemailer, src/email.ts) and
# every mail path (verification, reset, invitations, notifications)
# uses it when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Studio uploads (Phase 3) --------------------------------------------
# Uploaded videos are stored by the LOCAL development storage adapter
# under this directory (gitignored) — never inside the database.
# Point this at mounted/object-storage-backed storage in production.
MEDIA_DIR=./data/media

# Maximum accepted upload size in megabytes (development default 500).
# Never raise this beyond what the server/storage can actually hold.
MAX_UPLOAD_MB=500

# Upload sessions expire after this many minutes (default 30).
# UPLOAD_SESSION_TTL_MINUTES=30

# --- YouTube Data API (optional) ------------------------------------------
# Metadata ONLY (title/channel/duration) for the YouTube URL validator.
# The validator itself never downloads media. Downloading a video from
# a URL the user pastes is the separate URL-import feature below
# (yt-dlp). Leave empty for "not configured".
YOUTUBE_API_KEY=

# --- URL import (yt-dlp) ---------------------------------------------------
# "Import from URL" in the Studio: the user pastes a video page URL
# (YouTube or any yt-dlp-supported site) or a direct media link, and a
# background job downloads it (best MP4 up to 1080p, capped at
# MAX_UPLOAD_MB) as the project's source — verified by FFprobe exactly
# like an upload. Free and keyless: the open-source yt-dlp binary does
# the downloading. No cookies files, no account logins, ever.
# YTDLP_BIN=yt-dlp
# Set to false to disable the feature; when the binary cannot be
# resolved the endpoint answers an honest 422 CONFIGURATION_ERROR
# naming the missing dependency.
# URL_IMPORT_ENABLED=true
# DANGER — TESTING ONLY: lifts the SSRF guard's private/loopback
# address block so the e2e suites can import from their loopback
# fixture server. NEVER set this in production.
# URL_IMPORT_ALLOW_PRIVATE=

# --- Speech-to-text / AI clip detection (Phase 4) -------------------------
# STT_PROVIDER selects the transcription adapter:
#   local-faster-whisper (default) — runs scripts/transcribe.py with a
#     local Whisper model on this server. Needs python3 with the
#     faster_whisper + numpy packages importable.
#   openai-compatible — POSTs audio to STT_API_BASE/audio/transcriptions
#     with OPENAI_API_KEY. Without the key the provider reports itself
#     NOT configured and analysis jobs fail with a CONFIGURATION error
#     instead of producing fake transcripts.
STT_PROVIDER=local-faster-whisper
# Local provider: faster-whisper model name (default "small"; the
#   "base" model misdetects Hindi and is not recommended).
# OpenAI-compatible provider: model name sent to the endpoint
#   (default "whisper-1").
WHISPER_MODEL=small
# STT_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=
# PYTHON_BIN=python3

# Per-job scratch directory for extracted audio (cleaned up after
# every job; transcripts/candidates/previews persist elsewhere).
# PROCESSING_DIR=./data/processing

# --- Google OAuth (optional) --------------------------------------------
# All three must be set (and the OAuth flow enabled) before the
# "Continue with Google" control becomes functional. Until then the UI
# shows a clearly labelled not-configured state.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Social publishing (Phase 10) -----------------------------------------
# Each platform is enabled ONLY when its developer-app credentials are
# set. Until then the Publishing Center shows that platform as "not
# configured" (naming the missing variables) and its connect/publish
# endpoints return 422 CONFIGURATION_ERROR. Nothing is ever faked.
# These are separate from the Phase 2 Google SIGN-IN variables above:
# publishing uses its own OAuth client with the YouTube scopes.

# Public base URL of THIS server, used to build OAuth callbacks and
# to send the browser back to the app after a connection completes.
# PUBLIC_APP_URL=http://localhost:5173

# Token encryption key: base64 of exactly 32 random bytes, used to
# AES-256-GCM-encrypt stored platform tokens. If unset, a development
# key file is generated at server/data/.token-key (0600) and a warning
# is logged. PRODUCTION MUST SET THIS VARIABLE.
# TOKEN_ENCRYPTION_KEY=

# YouTube — Google Cloud project, YouTube Data API v3 enabled, OAuth
# client (Web). Authorized redirect URI:
#   http://localhost:3001/api/publishing/oauth/youtube/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/publishing/oauth/youtube/callback

# Instagram — Meta app with the Instagram API product (Instagram Login).
# OAuth redirect URI:
#   http://localhost:3001/api/publishing/oauth/instagram/callback
META_APP_ID=
META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:3001/api/publishing/oauth/instagram/callback
# META_WEBHOOK_VERIFY_TOKEN=<any random string you also enter in the Meta dashboard>

# TikTok — TikTok developer app with Login Kit + Content Posting API.
# Redirect URI registered in the app (must match exactly):
#   http://localhost:3001/api/publishing/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=http://localhost:3001/api/publishing/oauth/tiktok/callback

# Publishing worker tick (ms) and status-poll cadence (ms).
# Code defaults: PUBLISH_TICK_MS=1000 (src/config.ts), and the poll
# cadence is read as PUBLISH_STATUS_POLL_MS (src/publishing.ts,
# default 5000). NOTE: older copies of this file named the second
# variable STATUS_POLL_MS — that name is NOT read by the code and
# has no effect.
# PUBLISH_TICK_MS=1000
# PUBLISH_STATUS_POLL_MS=5000

# Render/export worker concurrency: how many renders run at once.
# Default 1 (encoding is CPU-bound; at 1 the behaviour is exactly the
# historical one-at-a-time queue). Clamped to 1–4; invalid values
# fall back to 1. Raise only on hardware with spare CPU cores.
# RENDER_CONCURRENCY=1

# --- Analytics (Phase 11) --------------------------------------------------
# Analytics reuses the Phase 10 platform connections and tokens — there
# are no separate analytics credentials. What each platform can return
# depends on the SCOPES the platform granted at connect time:
#   YouTube:   Analytics API metrics need the yt-analytics.readonly
#              scope in ADDITION to the Phase 10 upload/readonly scopes.
#              Without it, only Data API lifetime counters sync and the
#              capability panel says exactly that.
#   Instagram: media/account insights need instagram_business_manage_
#              insights. Phase 10 requested minimal scopes, so insights
#              stay "unavailable" (with the scope named) until the user
#              reconnects granting it.
#   TikTok:    post metrics need the video.list scope (Display API).
#              Without it, only profile counters (followers) sync.
# Capability detection runs BEFORE any metric request, and a metric a
# platform cannot provide is stored and shown as unavailable — never 0.

# Override for the YouTube Analytics API base URL (testing only).
# YOUTUBE_ANALYTICS_API_BASE=https://youtubeanalytics.googleapis.com

# Analytics worker tick (ms), retry backoff base (seconds), max sync
# attempts before a transient failure is terminal, and the directory
# generated report files are written to (default ./data/reports).
# ANALYTICS_TICK_MS=1000
# ANALYTICS_BACKOFF_BASE_SEC=30
# ANALYTICS_MAX_SYNC_ATTEMPTS=3
# ANALYTICS_REPORTS_DIR=./data/reports

# --- Account, Workspaces & Admin (Phase 12) --------------------------------
# Admin bootstrap: a comma-separated list of email addresses. An
# account whose email appears here is granted the server-side admin
# flag at registration and re-checked at every login. This is the ONLY
# way admin access is granted — the frontend can never grant it, and
# removing an address does not revoke an already-granted flag (remove
# the flag in the database if you ever need that).
# ADMIN_EMAILS=you@example.com

# Account worker tick (ms) for data-export and account-deletion jobs.
# Code default is 1000 (src/config.ts).
# ACCOUNT_TICK_MS=1000

# Avatars, data-export ZIPs and workspace logos are stored under the
# server data directory by default; override the locations if needed.
# AVATARS_DIR=./data/avatars
# DATA_EXPORTS_DIR=./data/data-exports
# WORKSPACE_LOGOS_DIR=./data/workspace-logos

# --- Payments (Phase 12, foundation only, DISABLED by default) -------------
# No payment provider is integrated in this build. Checkout endpoints
# answer an honest CONFIGURATION_ERROR until a real provider adapter
# exists. These variables only feed the status surface + webhook
# signature verification for the future adapter; setting them does NOT
# enable real charging by itself (the adapter also has to exist).
# PAYMENTS_ENABLED=false
# PAYMENT_PROVIDER=
# PAYMENT_MERCHANT_KEY_ID=
# PAYMENT_MERCHANT_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# =======================================================================
# Sections below were added in the Phase 13 inventory (2026-11-02):
# these variables ARE read by the code but were missing from this
# file. All are optional; every gate stays honestly "not configured"
# until its variables are set. See docs/ENVIRONMENT.md for the full
# authoritative inventory (84 server variables).
# =======================================================================

# --- STT aliases (Phase 4) ------------------------------------------------
# The OpenAI-compatible STT key/base are read with fallbacks:
#   key  = OPENAI_API_KEY, else STT_API_KEY
#   base = STT_API_BASE, else OPENAI_API_BASE, else https://api.openai.com/v1
# STT_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1

# --- Caption translation (Phase 6) -----------------------------------------
# No provider is configured by default; translation jobs then fail
# honestly with CONFIGURATION_ERROR. Manual translations always work.
# TRANSLATION_PROVIDER=
# TRANSLATION_API_KEY=
# TRANSLATION_API_BASE=

# --- Face / person tracking (Phase 7) ---------------------------------------
# Models default to server/models/ with the filenames below. The
# Silero VAD model defaults to the copy bundled with the local
# faster-whisper Python install; set this only to override it.
# TRACKING_MODELS_DIR=./models
# TRACKING_FACE_MODEL=face_detection_yunet_2023mar.onnx
# TRACKING_PERSON_MODEL=yolov8n.onnx
# SILERO_VAD_MODEL=

# --- B-roll / AI generation / background removal (Phase 8) ------------------
# Stock media: TWO adapters are implemented (src/broll.ts) — Pexels
# and Pixabay. Set PEXELS_API_KEY to a FREE key from pexels.com/api
# and stock search + import run for real against the Pexels Videos
# API (imported assets keep the Pexels licence + creator credit +
# source URL). If PEXELS_API_KEY is unset but PIXABAY_API_KEY is set
# (a FREE key from pixabay.com/api), the Pixabay Videos API is used
# instead, with Pixabay licence + creator credit persisted the same
# way. Without either key, stock search/import fail honestly with
# 422 CONFIGURATION_ERROR naming what is missing.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# Optional: name the stock provider explicitly (unset selects
# Pexels when its key is set, else Pixabay when its key is set).
# Any OTHER value has no adapter in this build and stays honestly
# not-implemented.
# STOCK_PROVIDER=pexels
# AI generation and background removal are still interface STUBS
# (implemented:false in src/broll.ts) — no genuinely free production
# API exists for either. Setting these variables alone does NOT
# enable them; the adapter body must also be implemented.
# AI_GENERATION_PROVIDER=
# AI_GENERATION_API_KEY=
# BACKGROUND_REMOVAL_PROVIDER=
# BACKGROUND_REMOVAL_API_KEY=
# BACKGROUND_MODEL_PATH=

# --- Provider endpoint overrides (TESTING / SANDBOX ONLY) -------------------
# These exist so the e2e suites can point the REAL adapters at a local
# mock provider, and staging can target a provider sandbox. Leave all
# of them UNSET in production — the defaults are the official
# production endpoints (src/config.ts).
# YOUTUBE_AUTH_BASE=https://accounts.google.com/o/oauth2/v2/auth
# YOUTUBE_TOKEN_URL=https://oauth2.googleapis.com/token
# YOUTUBE_REVOKE_URL=https://oauth2.googleapis.com/revoke
# YOUTUBE_API_BASE=https://www.googleapis.com
# META_AUTH_BASE=https://www.instagram.com/oauth/authorize
# META_TOKEN_URL=https://api.instagram.com/oauth/access_token
# META_GRAPH_BASE=https://graph.instagram.com
# TIKTOK_AUTH_BASE=https://www.tiktok.com/v2/auth/authorize
# TIKTOK_API_BASE=https://open.tiktokapis.com
# PEXELS_API_BASE=https://api.pexels.com
# PIXABAY_API_BASE=https://pixabay.com/api

# --- Hard-coded paths (NOT environment variables — listed so nobody
# goes looking for a knob that does not exist) ------------------------------
# * Email outbox (dev adapter): always server/data/outbox/
#   (src/email.ts) — follows the server install location, not an env var.
# * Dev token-encryption key file: always server/data/.token-key
#   (src/tokenCrypto.ts) — used only when TOKEN_ENCRYPTION_KEY is unset.
# * FFmpeg/FFprobe: invoked by bare name from PATH (no FFMPEG_PATH
#   variable exists). PYTHON_BIN is the only binary-path knob.
